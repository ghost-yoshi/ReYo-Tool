.venv
.gitignore
__pycache__/
*.egg-info/
.pytest_cache/

# artefacts de build (dist frontend copié par le Dockerfile)
static/

# frontend : dossier intégré au dépôt principal
frontend/node_modules/
frontend/dist/
frontend/.output/
frontend/.wrangler/
frontend/.env
frontend/.env.local
frontend/.git.embedded-backup/
